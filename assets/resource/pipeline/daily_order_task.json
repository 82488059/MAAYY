{
    "每日号令": {
        "attach": {
            "description": "入口。主界面打开菜单→门派→江湖号令，找业火焚身；没有则先认刷新，有则点齐全部刷新再找"
        },
        "action": "DoNothing",
        "next": [
            "号令_已开功能菜单"
        ],
        "timeout": 3000,
        "on_error": [
            "每日号令_结束失败"
        ]
    },
    "号令_已开功能菜单": {
        "attach": {
            "description": "功能菜单已开（能看到门派）：不再点主菜单，避免关掉"
        },
        "recognition": "OCR",
        "expected": [
            "^门派$",
            "门派"
        ],
        "order_by": "Expected",
        "roi": [
            800,
            80,
            480,
            640
        ],
        "threshold": 0.45,
        "action": "DoNothing",
        "post_delay": 300,
        "next": [
            "号令_点门派"
        ],
        "timeout": 1200,
        "rate_limit": 300,
        "on_error": [
            "号令_点主菜单"
        ]
    },
